<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>Swapwright</AssemblyName>
    <RootNamespace>Swapwright.Plugin</RootNamespace>
    <Version>0.1.0.0</Version>
    <Description>Swap a Penumbra dance mod onto one of your unlocked emotes, test it as a temporary mod, then install it as a new mod folder. Needs the swapd service running on the Linux host.</Description>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputPath>..\..\..\_shared\Build\Swapwright\</OutputPath>
    <Author>SloppyMods</Author>
    <Name>Swapwright</Name>
    <Punchline>Put a dance mod on any unlocked emote, test it, install it</Punchline>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Tags>penumbra, emote, dance, swap</Tags>
    <CategoryTags>utility</CategoryTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Swapwright.Core\Swapwright.Core.csproj" />
    <!-- Typed IPC subscribers. Talks to Penumbra over IPC only. -->
    <Reference Include="Penumbra.Api"><HintPath>..\..\lib\Penumbra.Api.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Luna"><HintPath>..\..\lib\Luna.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Luna.dll needs these at runtime and Dalamud does not provide them (copied from Penumbra 1.7.2.1). -->
    <None Include="..\..\lib\Microsoft.Extensions.*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Luna.dll drags Dalamud's own assemblies into the output; shipping private copies of those risks type-load clashes. Keep only ours. -->
  <Target Name="PruneDalamudCopies" AfterTargets="Build">
    <ItemGroup>
      <_Keep Include="Swapwright.dll;Swapwright.Core.dll;Swapwright.json;Swapwright.deps.json;Swapwright.pdb;Swapwright.Core.pdb;Penumbra.Api.dll;Luna.dll;Microsoft.Extensions.DependencyInjection.Abstractions.dll;Microsoft.Extensions.DependencyInjection.dll;Microsoft.Extensions.Logging.Abstractions.dll;Microsoft.Extensions.Logging.dll;Microsoft.Extensions.Options.dll;Microsoft.Extensions.Primitives.dll" />
      <_OutFiles Include="$(OutDir)*.dll;$(OutDir)*.xml" />
      <_Prune Include="@(_OutFiles)" Exclude="@(_Keep->'$(OutDir)%(Identity)')" />
    </ItemGroup>
    <Delete Files="@(_Prune)" />
  </Target>
</Project>
